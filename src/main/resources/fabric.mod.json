{
	"schemaVersion": 1,
	"id": "opencraft",
	"version": "${version}",
	"name": "OpenCraft",
	"description": "AI game assistant companion mod for Minecraft 1.21.11. An AI-powered bot joins your server, follows you, and executes real player actions (moving, mining, placing, crafting, container interactions) via an OpenAI-compatible Chat Completions API.",
	"authors": [
		"SwayDy"
	],
	"contact": {
		"homepage": "https://github.com/ningyx25/opencraft",
		"sources": "https://github.com/ningyx25/opencraft",
		"issues": "https://github.com/ningyx25/opencraft/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/opencraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.swaydy.opencraft.OpenCraftMod"
		],
		"client": [
			"com.swaydy.opencraft.client.OpenCraftModClient"
		],
		"fabric-gametest": [
			"com.swaydy.opencraft.test.OpenCraftGameTests"
		]
	},
	"accessWidener": "opencraft.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}