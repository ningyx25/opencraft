# 复制为 .env 并填入真实值。.env 已加入 .gitignore，不会被提交。
# 这些环境变量会被 build.gradle 读取并注入到本项目的 run 任务
# （runClient / runServer / runGametestServer），仅在本项目生效。

# AI 接口默认地址（未设置时回退到 OpenAI 官方默认地址）
OPEN_CRAFT_BASE_URL=https://api.openai.com/v1

# AI 模型默认名称（未设置时回退到 OpenAI 默认模型）
OPEN_CRAFT_MODEL=gpt-4o

# API Key（未设置时回退到代码内混淆默认值；不明文入库）
OPEN_CRAFT_API_KEY=sk-your-key-here
